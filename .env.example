# Get a free API key at https://resend.com after verifying your sending domain
# (or use the resend.dev testing sender until a custom domain is set up).
RESEND_API_KEY=

# Where enquiry emails should be delivered. Defaults to hello@jezzbakes.co.uk.
ENQUIRY_TO_EMAIL=hello@jezzbakes.co.uk

# The "from" address emails are sent as. Must be on a domain verified with Resend.
# Until a domain is verified, leave this unset to use Resend's shared test sender.
RESEND_FROM_EMAIL="Jezz Bakes Website <onboarding@resend.dev>"
